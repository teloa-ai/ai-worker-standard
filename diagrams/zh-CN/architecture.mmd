    B --> X["一次 Run<br/>固定输入版本与有效授权"]
    X --> A["固定成果与实际贡献者"]
    A --> R["验收记录<br/>业务采用另记"]
    classDef main fill:#164e63,color:#fff,stroke:#164e63
